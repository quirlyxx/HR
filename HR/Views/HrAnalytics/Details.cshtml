@model HR.Services.ResumeInfo
@{
    ViewData["Title"] = "Деталі кандидата";
    Layout = null;
    var a = Model.Analysis;
    var pct = a?.MatchPercentage ?? 0;
    var lvl = pct >= 70 ? "high" : pct >= 40 ? "mid" : "low";
    var verdict = pct >= 70 ? "Підходить" : pct >= 40 ? "Частково підходить" : "Не підходить";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --desk: #3B3F44;
            --desk-soft: #464A50;
            --paper: #FBF7EE;
            --paper-edge: #E4DCC8;
            --text: #2B2A28;
            --muted: #8D8577;
            --highlight: #F2C94C;
            --clip: #A9AFB5;
            --clip-dark: #7C8288;
            --danger: #B23A2E;
            --ok: #2E7D46;
            --ok-bg: #E7F3EA;
            --err-bg: #F6E6E3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            background:
                radial-gradient(
                    ellipse at top,
                    var(--desk-soft),
                    var(--desk) 75%
                );

            font-family: 'IBM Plex Sans', sans-serif;
            color: var(--text);

            display: flex;
            flex-direction: column;
        }

        .site-nav {
            position: sticky;
            top: 0;
            z-index: 20;

            width: 100%;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 12px;

            padding: 14px 28px;

            background: rgba(30, 33, 37, 0.92);
            backdrop-filter: blur(6px);

            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .site-nav .brand {
            font-family: 'Permanent Marker', cursive;

            color: var(--paper);

            font-size: 1.05rem;

            text-decoration: none;

            white-space: nowrap;
        }

        .site-nav .links {
            display: flex;

            gap: 4px;

            flex-wrap: wrap;
        }

        .site-nav a.nav-link {
            color: var(--paper);

            opacity: 0.75;

            text-decoration: none;

            font-size: 0.85rem;

            font-weight: 500;

            padding: 8px 14px;

            border-radius: 6px;

            transition: background 0.15s ease, opacity 0.15s ease;
        }

        .site-nav a.nav-link:hover {
            opacity: 1;

            background: rgba(255, 255, 255, 0.08);
        }

        .site-nav a.nav-link.active {
            opacity: 1;

            background: var(--highlight);

            color: #2B2A28;

            font-weight: 600;
        }

        .page {
            flex: 1;

            display: flex;
            justify-content: center;

            padding: 60px 20px 80px;
        }

        .board {
            position: relative;
            width: 100%;
            max-width: 900px;
        }

        .clip {
            position: absolute;
            top: -34px;
            left: 50%;

            transform: translateX(-50%);

            width: 140px;
            height: 46px;

            background:
                linear-gradient(
                    180deg,
                    #C7CCD1,
                    var(--clip) 55%,
                    var(--clip-dark)
                );

            border-radius: 8px;

            box-shadow:
                0 8px 16px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.4);

            z-index: 2;
        }

        .clip::after {
            content: "";

            position: absolute;

            left: 50%;
            top: 100%;

            transform: translateX(-50%);

            width: 60px;
            height: 14px;

            background: var(--clip-dark);

            border-radius: 0 0 6px 6px;
        }

        .paper {
            position: relative;

            background: var(--paper);

            border: 1px solid var(--paper-edge);
            border-radius: 6px;

            padding: 56px 40px 40px;

            box-shadow:
                0 24px 60px rgba(0, 0, 0, 0.5),
                0 2px 0 var(--paper-edge);
        }

        .banner {
            border-radius: 6px;

            padding: 12px 16px;

            font-size: 0.9rem;

            margin-bottom: 24px;
        }

        .banner.ok {
            background: var(--ok-bg);
            color: var(--ok);

            border: 1px solid var(--ok);
        }

        .banner.err {
            background: var(--err-bg);
            color: var(--danger);

            border: 1px solid var(--danger);
        }

        .page-head {
            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 16px;

            flex-wrap: wrap;

            margin-bottom: 30px;
        }

        h1 {
            font-family: 'Permanent Marker', cursive;

            font-weight: 400;

            font-size: 1.8rem;

            margin: 0 0 8px;

            color: var(--text);
        }

        .lede {
            color: var(--muted);

            margin: 0;

            line-height: 1.55;

            max-width: 55ch;
        }

        .count-pill {
            flex-shrink: 0;

            background: var(--text);
            color: var(--paper);

            font-size: 0.8rem;
            font-weight: 600;

            padding: 6px 14px;

            border-radius: 999px;

            white-space: nowrap;
        }

        .resume-list {
            display: flex;
            flex-direction: column;
        }

        .resume-card {
            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 18px;

            padding: 18px 4px;

            border-bottom: 1px dashed var(--paper-edge);

            flex-wrap: wrap;
        }

        .resume-card:last-child {
            border-bottom: none;
        }

        .resume-info {
            display: flex;

            flex-direction: column;

            gap: 4px;

            min-width: 0;
        }

        .resume-name {
            font-weight: 600;

            font-size: 1.05rem;

            color: var(--text);
        }

        .resume-meta {
            color: var(--muted);

            font-size: 0.83rem;

            line-height: 1.5;
        }

        .resume-meta .file-name {
            display: inline-flex;

            align-items: center;

            gap: 5px;
        }

        .resume-meta .sep {
            margin: 0 6px;

            opacity: 0.6;
        }

        .resume-actions {
            display: flex;

            gap: 8px;

            flex-shrink: 0;
        }

        .btn-open,
        .btn-delete {
            font-family: 'IBM Plex Sans', sans-serif;

            font-weight: 600;

            font-size: 0.82rem;

            border-radius: 6px;

            padding: 9px 16px;

            cursor: pointer;

            text-decoration: none;

            border: 1px solid transparent;

            transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
            white-space: nowrap;
        }

        .btn-open {
            background: var(--text);
            color: var(--paper);
        }

        .btn-open:hover {
            background: var(--danger);

            transform: translateY(-1px);
        }

        .btn-delete {
            background: transparent;

            color: var(--danger);

            border-color: var(--danger);
        }

        .btn-delete:hover {
            background: var(--err-bg);
        }

        .empty-state {
            text-align: center;

            padding: 46px 10px 20px;

            color: var(--muted);
        }

        .empty-state .icon {
            font-size: 2.4rem;

            margin-bottom: 14px;
        }

        .empty-state p {
            margin: 0;

            line-height: 1.6;
        }

        .resume-analysis {
            flex-basis: 100%;

            background: #F4EEDD;

            border-radius: 6px;

            padding: 12px 16px;

            font-size: 0.88rem;

            line-height: 1.55;
        }

        .analysis-head {
            display: flex;

            align-items: center;

            gap: 12px;

            flex-wrap: wrap;

            margin-bottom: 8px;
        }

        .match-pill {
            font-weight: 600;

            font-size: 0.8rem;

            color: #fff;

            padding: 4px 12px;

            border-radius: 999px;
        }

        .match-pill.high { background: var(--ok); }
        .match-pill.mid { background: #B8860B; }
        .match-pill.low { background: var(--danger); }

        .analysis-exp {
            color: var(--muted);
        }

        .skill-list {
            display: flex;

            flex-wrap: wrap;

            gap: 6px;

            margin-bottom: 8px;
        }

        .skill {
            background: var(--paper);

            border: 1px solid var(--paper-edge);

            border-radius: 4px;

            padding: 2px 8px;

            font-size: 0.78rem;
        }

        .analysis-text {
            margin: 0;

            color: var(--text);
        }

        .analysis-pending {
            color: var(--muted);
        }

        @@media (max-width: 640px) {
            .site-nav {
                flex-direction: column;
                align-items: flex-start;

                gap: 10px;

                padding: 14px 16px;
            }

            .site-nav .links {
                width: 100%;

                justify-content: space-between;
            }

            .page {
                padding: 30px 12px 40px;
            }

            .paper {
                padding: 48px 20px 30px;
            }

            h1 {
                font-size: 1.5rem;
            }

            .resume-card {
                flex-direction: column;

                align-items: stretch;
            }

            .resume-actions {
                width: 100%;
            }

            .btn-open,
            .btn-delete {
                flex: 1;

                text-align: center;
            }
        }
    
        .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 6px 0 20px; }
        .kpi { background: #F4EEDD; border: 1px solid var(--paper-edge); border-radius: 6px; padding: 14px 16px; }
        .kpi b { display: block; font-size: 1.9rem; line-height: 1.1; }
        .kpi span { color: var(--muted); font-size: 0.82rem; }
        .charts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 26px; }
        .chart { border: 1px solid var(--paper-edge); border-radius: 6px; padding: 14px 16px; }
        .chart h3 { margin: 0 0 12px; font-size: 0.95rem; }
        .bar-row { display: grid; grid-template-columns: 100px 1fr 26px; gap: 8px; align-items: center; font-size: 0.82rem; margin-bottom: 8px; }
        .bar-row .lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .track { background: var(--paper-edge); height: 10px; border-radius: 999px; overflow: hidden; }
        .fill { display: block; height: 100%; border-radius: 999px; background: var(--clip-dark); }
        .fill.ok { background: var(--ok); } .fill.mid { background: #B8860B; } .fill.low { background: var(--danger); }
        .no-data { color: var(--muted); font-size: 0.85rem; }
        .table-wrap { overflow-x: auto; }
        table.cand { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        table.cand th { text-align: left; color: var(--muted); font-weight: 500; font-size: 0.75rem; text-transform: uppercase; padding: 8px 10px; border-bottom: 2px solid var(--paper-edge); }
        table.cand td { padding: 12px 10px; border-bottom: 1px solid var(--paper-edge); vertical-align: middle; }
        .sub { color: var(--muted); font-size: 0.8rem; }
        .status-wait { background: #F4EEDD; color: var(--muted); border: 1px solid var(--paper-edge); padding: 4px 12px; border-radius: 999px; font-size: 0.8rem; white-space: nowrap; }
        .btn-detail { display: inline-block; text-decoration: none; background: var(--text); color: var(--paper); padding: 7px 14px; border-radius: 6px; font-size: 0.82rem; font-weight: 500; white-space: nowrap; }
        .btn-detail:hover { background: #000; }
        .back { display: inline-block; margin-bottom: 14px; color: var(--muted); text-decoration: none; font-size: 0.9rem; }
        .score { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin: 4px 0 18px; }
        .big-pct { font-size: 3rem; font-weight: 600; line-height: 1; }
        .big-pct.high { color: var(--ok); } .big-pct.mid { color: #B8860B; } .big-pct.low { color: var(--danger); }
        .score .track { flex: 1; min-width: 180px; height: 12px; }
        .sec { margin-top: 18px; } .sec .lbl { color: var(--muted); font-size: 0.78rem; text-transform: uppercase; margin-bottom: 6px; }
        @@media (max-width: 860px) { .kpis { grid-template-columns: 1fr 1fr; } .charts { grid-template-columns: 1fr; } }
    </style>
</head>

<body>
    @{ ViewData["Active"] = "analytics"; }
    @await Html.PartialAsync("_TopNav")
    <div class="page"><div class="board"><div class="clip"></div><div class="paper">
        <a class="back" href="/HrAnalytics">← До списку кандидатів</a>
        <div class="page-head">
            <div>
                <h1>@(string.IsNullOrWhiteSpace(Model.CandidateName) ? "Кандидат" : Model.CandidateName)</h1>
                <p class="lede">@Model.ContactInfo · @Model.OriginalFileName · @Model.UploadedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
            </div>
            <a class="btn-detail" href="@Url.Action("Open", "Resumes", new { key = Model.Key })" target="_blank" rel="noopener">Відкрити резюме</a>
        </div>

        @if (a == null)
        {
            <div class="empty-state"><div class="icon">⏳</div><p><b>Очікує аналізу</b><br />Gemini ще обробляє це резюме. Оновіть сторінку за кілька секунд.</p></div>
        }
        else
        {
            if (a.MatchPercentage != null)
            {
                <div class="score">
                    <div class="big-pct @lvl">@(pct)%</div>
                    <span class="match-pill @lvl">@verdict</span>
                    <span class="track"><i class="fill @lvl" style="width:@(pct)%"></i></span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(a.CandidateName) || !string.IsNullOrWhiteSpace(a.BirthDate))
            {
                <div class="sec"><div class="lbl">Дані з резюме</div>
                    <div>@a.CandidateName@(string.IsNullOrWhiteSpace(a.BirthDate) ? "" : " · " + a.BirthDate)</div></div>
            }
            @if (!string.IsNullOrWhiteSpace(a.Experience)) { <div class="sec"><div class="lbl">Досвід</div><div>@a.Experience</div></div> }
            @if (a.Skills.Count > 0)
            {
                <div class="sec"><div class="lbl">Навички</div><div class="skill-list">@foreach (var sk in a.Skills) { <span class="skill">@sk</span> }</div></div>
            }
            @if (!string.IsNullOrWhiteSpace(a.Description)) { <div class="sec"><div class="lbl">Висновок</div><div>@a.Description</div></div> }
        }
    </div></div></div>
</body>
</html>
