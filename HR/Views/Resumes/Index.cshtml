@model List<ResumeInfo>
@{
    ViewData["Title"] = "Резюме кандидатів";
    Layout = null;

    // Захист від null: навіть якщо щось піде не так вище по ланцюгу,
    // сторінка не впаде, а просто покаже порожній список.
    var resumes = Model ?? new List<ResumeInfo>();
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --desk: #3B3F44;
            --desk-soft: #464A50;
            --paper: #FBF7EE;
            --paper-edge: #E4DCC8;
            --text: #2B2A28;
            --muted: #8D8577;
            --highlight: #F2C94C;
            --clip: #A9AFB5;
            --clip-dark: #7C8288;
            --danger: #B23A2E;
            --ok: #2E7D46;
            --ok-bg: #E7F3EA;
            --err-bg: #F6E6E3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            background:
                radial-gradient(
                    ellipse at top,
                    var(--desk-soft),
                    var(--desk) 75%
                );

            font-family: 'IBM Plex Sans', sans-serif;
            color: var(--text);

            display: flex;
            flex-direction: column;
        }

        .site-nav {
            position: sticky;
            top: 0;
            z-index: 20;

            width: 100%;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 12px;

            padding: 14px 28px;

            background: rgba(30, 33, 37, 0.92);
            backdrop-filter: blur(6px);

            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .site-nav .brand {
            font-family: 'Permanent Marker', cursive;

            color: var(--paper);

            font-size: 1.05rem;

            text-decoration: none;

            white-space: nowrap;
        }

        .site-nav .links {
            display: flex;

            gap: 4px;

            flex-wrap: wrap;
        }

        .site-nav a.nav-link {
            color: var(--paper);

            opacity: 0.75;

            text-decoration: none;

            font-size: 0.85rem;

            font-weight: 500;

            padding: 8px 14px;

            border-radius: 6px;

            transition: background 0.15s ease, opacity 0.15s ease;
        }

        .site-nav a.nav-link:hover {
            opacity: 1;

            background: rgba(255, 255, 255, 0.08);
        }

        .site-nav a.nav-link.active {
            opacity: 1;

            background: var(--highlight);

            color: #2B2A28;

            font-weight: 600;
        }

        .page {
            flex: 1;

            display: flex;
            justify-content: center;

            padding: 60px 20px 80px;
        }

        .board {
            position: relative;
            width: 100%;
            max-width: 900px;
        }

        .clip {
            position: absolute;
            top: -34px;
            left: 50%;

            transform: translateX(-50%);

            width: 140px;
            height: 46px;

            background:
                linear-gradient(
                    180deg,
                    #C7CCD1,
                    var(--clip) 55%,
                    var(--clip-dark)
                );

            border-radius: 8px;

            box-shadow:
                0 8px 16px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.4);

            z-index: 2;
        }

        .clip::after {
            content: "";

            position: absolute;

            left: 50%;
            top: 100%;

            transform: translateX(-50%);

            width: 60px;
            height: 14px;

            background: var(--clip-dark);

            border-radius: 0 0 6px 6px;
        }

        .paper {
            position: relative;

            background: var(--paper);

            border: 1px solid var(--paper-edge);
            border-radius: 6px;

            padding: 56px 40px 40px;

            box-shadow:
                0 24px 60px rgba(0, 0, 0, 0.5),
                0 2px 0 var(--paper-edge);
        }

        .banner {
            border-radius: 6px;

            padding: 12px 16px;

            font-size: 0.9rem;

            margin-bottom: 24px;
        }

        .banner.ok {
            background: var(--ok-bg);
            color: var(--ok);

            border: 1px solid var(--ok);
        }

        .banner.err {
            background: var(--err-bg);
            color: var(--danger);

            border: 1px solid var(--danger);
        }

        .page-head {
            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 16px;

            flex-wrap: wrap;

            margin-bottom: 30px;
        }

        h1 {
            font-family: 'Permanent Marker', cursive;

            font-weight: 400;

            font-size: 1.8rem;

            margin: 0 0 8px;

            color: var(--text);
        }

        .lede {
            color: var(--muted);

            margin: 0;

            line-height: 1.55;

            max-width: 55ch;
        }

        .count-pill {
            flex-shrink: 0;

            background: var(--text);
            color: var(--paper);

            font-size: 0.8rem;
            font-weight: 600;

            padding: 6px 14px;

            border-radius: 999px;

            white-space: nowrap;
        }

        .resume-list {
            display: flex;
            flex-direction: column;
        }

        .resume-card {
            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 18px;

            padding: 18px 4px;

            border-bottom: 1px dashed var(--paper-edge);

            flex-wrap: wrap;
        }

        .resume-card:last-child {
            border-bottom: none;
        }

        .resume-info {
            display: flex;

            flex-direction: column;

            gap: 4px;

            min-width: 0;
        }

        .resume-name {
            font-weight: 600;

            font-size: 1.05rem;

            color: var(--text);
        }

        .resume-meta {
            color: var(--muted);

            font-size: 0.83rem;

            line-height: 1.5;
        }

        .resume-meta .file-name {
            display: inline-flex;

            align-items: center;

            gap: 5px;
        }

        .resume-meta .sep {
            margin: 0 6px;

            opacity: 0.6;
        }

        .resume-actions {
            display: flex;

            gap: 8px;

            flex-shrink: 0;
        }

        .btn-open,
        .btn-delete {
            font-family: 'IBM Plex Sans', sans-serif;

            font-weight: 600;

            font-size: 0.82rem;

            border-radius: 6px;

            padding: 9px 16px;

            cursor: pointer;

            text-decoration: none;

            border: 1px solid transparent;

            transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
            white-space: nowrap;
        }

        .btn-open {
            background: var(--text);
            color: var(--paper);
        }

        .btn-open:hover {
            background: var(--danger);

            transform: translateY(-1px);
        }

        .btn-delete {
            background: transparent;

            color: var(--danger);

            border-color: var(--danger);
        }

        .btn-delete:hover {
            background: var(--err-bg);
        }

        .empty-state {
            text-align: center;

            padding: 46px 10px 20px;

            color: var(--muted);
        }

        .empty-state .icon {
            font-size: 2.4rem;

            margin-bottom: 14px;
        }

        .empty-state p {
            margin: 0;

            line-height: 1.6;
        }

        @@media (max-width: 640px) {
            .site-nav {
                flex-direction: column;
                align-items: flex-start;

                gap: 10px;

                padding: 14px 16px;
            }

            .site-nav .links {
                width: 100%;

                justify-content: space-between;
            }

            .page {
                padding: 30px 12px 40px;
            }

            .paper {
                padding: 48px 20px 30px;
            }

            h1 {
                font-size: 1.5rem;
            }

            .resume-card {
                flex-direction: column;

                align-items: stretch;
            }

            .resume-actions {
                width: 100%;
            }

            .btn-open,
            .btn-delete {
                flex: 1;

                text-align: center;
            }
        }
    </style>
</head>

<body>

    @{ ViewData["Active"] = "resumes"; }
    @await Html.PartialAsync("_TopNav")

    <div class="page">

    <div class="board">

        <div class="clip"></div>

        <div class="paper">

            @if (TempData["ResumeMessage"] != null)
            {
                <div class="banner ok">
                    ✅ @TempData["ResumeMessage"]
                </div>
            }

            @if (TempData["ResumeError"] != null)
            {
                <div class="banner err">
                    ⚠️ @TempData["ResumeError"]
                </div>
            }

            <div class="page-head">
                <div>
                    <h1>Резюме кандидатів</h1>
                    <p class="lede">
                        Усі резюме, надіслані через форму кандидата.
                        Файли зберігаються в Amazon S3.
                    </p>
                </div>

                @if (resumes.Count > 0)
                {
                    <span class="count-pill">
                        Усього: @resumes.Count
                    </span>
                }
            </div>

            @if (resumes.Count == 0)
            {
                <div class="empty-state">
                    <div class="icon">🗂️</div>
                    <p>
                        Поки що жодного резюме не надіслано.<br />
                        Як тільки кандидат заповнить форму, воно з'явиться тут.
                    </p>
                </div>
            }
            else
            {
                <div class="resume-list">
                    @foreach (var resume in resumes)
                    {
                        <div class="resume-card">

                            <div class="resume-info">
                                <span class="resume-name">@resume.CandidateName</span>
                                <span class="resume-meta">
                                    @resume.ContactInfo
                                    <span class="sep">•</span>
                                    <span class="file-name">📄 @resume.OriginalFileName</span>
                                    <span class="sep">•</span>
                                    @resume.UploadedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>

                            <div class="resume-actions">
                                <a class="btn-open"
                                   asp-controller="Resumes"
                                   asp-action="Open"
                                   asp-route-key="@resume.Key"
                                   target="_blank"
                                   rel="noopener">
                                    Відкрити
                                </a>

                                <form asp-controller="Resumes"
                                      asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Видалити резюме цього кандидата?');">
                                    <input type="hidden" name="key" value="@resume.Key" />
                                    <button type="submit" class="btn-delete">
                                        Видалити
                                    </button>
                                </form>
                            </div>

                        </div>
                    }
                </div>
            }

        </div>

    </div>

    </div>

</body>
</html>
