@{
    ViewData["Title"] = "Резюме кандидата";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --desk: #3B3F44;
            --desk-soft: #464A50;
            --paper: #FBF7EE;
            --paper-edge: #E4DCC8;
            --text: #2B2A28;
            --muted: #8D8577;
            --highlight: #F2C94C;
            --clip: #A9AFB5;
            --clip-dark: #7C8288;
            --danger: #B23A2E;
            --ok: #2E7D46;
            --ok-bg: #E7F3EA;
            --err-bg: #F6E6E3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            background:
                radial-gradient(
                    ellipse at top,
                    var(--desk-soft),
                    var(--desk) 75%
                );

            font-family: 'IBM Plex Sans', sans-serif;
            color: var(--text);

            display: flex;
            flex-direction: column;
        }

        .site-nav {
            position: sticky;
            top: 0;
            z-index: 20;

            width: 100%;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 12px;

            padding: 14px 28px;

            background: rgba(30, 33, 37, 0.92);
            backdrop-filter: blur(6px);

            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .site-nav .brand {
            font-family: 'Permanent Marker', cursive;

            color: var(--paper);

            font-size: 1.05rem;

            text-decoration: none;

            white-space: nowrap;
        }

        .site-nav .links {
            display: flex;

            gap: 4px;

            flex-wrap: wrap;
        }

        .site-nav a.nav-link {
            color: var(--paper);

            opacity: 0.75;

            text-decoration: none;

            font-size: 0.85rem;

            font-weight: 500;

            padding: 8px 14px;

            border-radius: 6px;

            transition: background 0.15s ease, opacity 0.15s ease;
        }

        .site-nav a.nav-link:hover {
            opacity: 1;

            background: rgba(255, 255, 255, 0.08);
        }

        .site-nav a.nav-link.active {
            opacity: 1;

            background: var(--highlight);

            color: #2B2A28;

            font-weight: 600;
        }

        .page {
            flex: 1;

            display: flex;
            justify-content: center;

            padding: 70px 20px 80px;
        }

        .board {
            position: relative;
            width: 100%;
            max-width: 620px;
        }

        .clip {
            position: absolute;
            top: -34px;
            left: 50%;

            transform: translateX(-50%);

            width: 140px;
            height: 46px;

            background:
                linear-gradient(
                    180deg,
                    #C7CCD1,
                    var(--clip) 55%,
                    var(--clip-dark)
                );

            border-radius: 8px;

            box-shadow:
                0 8px 16px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.4);

            z-index: 2;
        }

        .clip::after {
            content: "";

            position: absolute;

            left: 50%;
            top: 100%;

            transform: translateX(-50%);

            width: 60px;
            height: 14px;

            background: var(--clip-dark);

            border-radius: 0 0 6px 6px;
        }

        .paper {
            position: relative;

            background: var(--paper);

            border: 1px solid var(--paper-edge);
            border-radius: 6px;

            padding: 56px 40px 40px;

            box-shadow:
                0 24px 60px rgba(0, 0, 0, 0.5),
                0 2px 0 var(--paper-edge);
        }

        .banner {
            border-radius: 6px;

            padding: 12px 16px;

            font-size: 0.9rem;

            margin-bottom: 24px;
        }

        .banner.ok {
            background: var(--ok-bg);
            color: var(--ok);

            border: 1px solid var(--ok);
        }

        .banner.err {
            background: var(--err-bg);
            color: var(--danger);

            border: 1px solid var(--danger);
        }

        h1 {
            font-family: 'Permanent Marker', cursive;

            font-weight: 400;

            font-size: 1.8rem;

            margin: 0 0 8px;

            color: var(--text);
        }

        .lede {
            color: var(--muted);

            margin: 0 0 36px;

            line-height: 1.55;

            max-width: 55ch;
        }

        .field {
            margin-bottom: 26px;
        }

        .field label {
            display: block;

            font-size: 0.85rem;

            color: var(--muted);

            margin-bottom: 6px;
        }

        .field input[type="text"] {
            width: 100%;

            border: none;
            border-bottom: 1px solid #D8CFB9;

            background: transparent;

            font-family: 'IBM Plex Sans', sans-serif;

            font-size: 1.05rem;

            padding: 6px 2px;

            color: var(--text);

            outline: none;

            transition: border-color 0.15s ease;
        }

        .field input[type="text"]:focus {
            border-bottom: 2px solid var(--text);
        }

        .file-block-heading {
            border-bottom: 1px dashed var(--paper-edge);

            padding-bottom: 8px;

            margin-bottom: 14px;
        }

        .file-block-heading h2 {
            font-family: 'Permanent Marker', cursive;

            font-weight: 400;

            font-size: 1.1rem;

            margin: 0;

            color: var(--text);
        }

        .file-drop {
            border: 1px dashed var(--clip-dark);
            border-radius: 6px;

            padding: 22px;

            text-align: center;

            color: var(--muted);

            font-size: 0.9rem;
        }

        .file-drop input[type="file"] {
            display: block;
            margin: 12px auto 0;

            font-family: 'IBM Plex Sans', sans-serif;
        }

        .file-hint {
            display: block;

            margin-top: 6px;

            font-size: 0.78rem;

            color: var(--muted);
        }

        .submit-row {
            display: flex;

            align-items: center;

            gap: 18px;

            margin-top: 32px;
        }

        .submit-btn {
            font-family: 'IBM Plex Sans', sans-serif;

            font-weight: 600;

            font-size: 0.95rem;

            background: var(--text);

            color: var(--paper);

            border: none;

            padding: 14px 30px;

            border-radius: 6px;

            cursor: pointer;

            transition:
                transform 0.15s ease,
                background 0.15s ease;
        }

        .submit-btn:hover {
            background: var(--danger);

            transform: translateY(-1px);
        }

        .submit-btn:disabled {
            opacity: 0.6;

            cursor: wait;

            transform: none;
        }

        .submit-hint {
            color: var(--muted);

            font-size: 0.82rem;
        }

        @@media (max-width: 640px) {
            .site-nav {
                flex-direction: column;
                align-items: flex-start;

                gap: 10px;

                padding: 14px 16px;
            }

            .site-nav .links {
                width: 100%;

                justify-content: space-between;
            }

            .page {
                padding: 30px 12px 40px;
            }

            .paper {
                padding: 48px 22px 30px;
            }

            h1 {
                font-size: 1.5rem;
            }

            .submit-row {
                flex-direction: column;

                align-items: stretch;
            }

            .submit-btn {
                width: 100%;
            }

            .submit-hint {
                text-align: center;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .submit-btn {
                transition: none;
            }
        }
    </style>
</head>

<body>

    @{ ViewData["Active"] = "candidate"; }
    @await Html.PartialAsync("_Nav")

    <div class="page">

    <div class="board">

        <div class="clip"></div>

        <div class="paper">

            @if (TempData["UploadSuccess"] != null)
            {
                <div class="banner ok">
                    ✅ @TempData["UploadSuccess"]
                </div>
            }

            @if (TempData["UploadError"] != null)
            {
                <div class="banner err">
                    ⚠️ @TempData["UploadError"]
                </div>
            }

            <h1>Резюме кандидата</h1>

            <p class="lede">
                Вкажіть ваше ім'я, контактні дані та прикріпіть резюме
                у форматі PDF — ми розглянемо його якнайшвидше.
            </p>

            <form asp-area="Candidate"
                  asp-controller="Resume"
                  asp-action="Upload"
                  method="post"
                  enctype="multipart/form-data"
                  id="candidateForm">

                <div class="field">

                    <label for="FullName">
                        Ім'я та прізвище
                    </label>

                    <input type="text"
                           name="FullName"
                           id="FullName"
                           placeholder="Іван Петренко"
                           autocomplete="name"
                           required />

                </div>

                <div class="field">

                    <label for="ContactInfo">
                        Контактні дані (телефон або e-mail)
                    </label>

                    <input type="text"
                           name="ContactInfo"
                           id="ContactInfo"
                           placeholder="ivan.petrenko@example.com"
                           autocomplete="email"
                           required />

                </div>

                <div class="file-block-heading">
                    <h2>Резюме</h2>
                </div>

                <div class="file-drop">
                    Оберіть файл резюме

                    <input type="file"
                           name="ResumeFile"
                           id="ResumeFile"
                           accept=".pdf,application/pdf"
                           required />

                    <span class="file-hint">
                        Тільки PDF, до 10 МБ
                    </span>
                </div>

                <div class="submit-row">

                    <button type="submit"
                            class="submit-btn"
                            id="sendButton">
                        Надіслати резюме
                    </button>

                    <span class="submit-hint">
                        Ваші дані бачитимуть лише HR-фахівці
                    </span>

                </div>

            </form>

        </div>

    </div>

    </div>

    <script>
        const form = document.getElementById("candidateForm");
        const button = document.getElementById("sendButton");

        form.addEventListener("submit", function () {
            button.disabled = true;
            button.textContent = "Надсилання...";
        });
    </script>

</body>
</html>
