@{
    ViewData["Title"] = "Вимоги до кандидата";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
          rel="stylesheet">

    <style>
            :root {
                --desk: #3B3F44;
                --desk-soft: #464A50;
                --paper: #FBF7EE;
                --paper-edge: #E4DCC8;
                --text: #2B2A28;
                --muted: #8D8577;
                --highlight: #F2C94C;
                --clip: #A9AFB5;
                --clip-dark: #7C8288;
                --danger: #B23A2E;
                --ok: #2E7D46;
                --ok-bg: #E7F3EA;
                --err-bg: #F6E6E3;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;

                background:
                    radial-gradient(
                        ellipse at top,
                        var(--desk-soft),
                        var(--desk) 75%
                    );

                font-family: 'IBM Plex Sans', sans-serif;
                color: var(--text);

                display: flex;
                flex-direction: column;
            }

            .site-nav {
                position: sticky;
                top: 0;
                z-index: 20;

                width: 100%;

                display: flex;
                align-items: center;
                justify-content: space-between;

                gap: 12px;

                padding: 14px 28px;

                background: rgba(30, 33, 37, 0.92);
                backdrop-filter: blur(6px);

                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }

            .site-nav .brand {
                font-family: 'Permanent Marker', cursive;

                color: var(--paper);

                font-size: 1.05rem;

                text-decoration: none;

                white-space: nowrap;
            }

            .site-nav .links {
                display: flex;

                gap: 4px;

                flex-wrap: wrap;
            }

            .site-nav a.nav-link {
                color: var(--paper);

                opacity: 0.75;

                text-decoration: none;

                font-size: 0.85rem;

                font-weight: 500;

                padding: 8px 14px;

                border-radius: 6px;

                transition: background 0.15s ease, opacity 0.15s ease;
            }

            .site-nav a.nav-link:hover {
                opacity: 1;

                background: rgba(255, 255, 255, 0.08);
            }

            .site-nav a.nav-link.active {
                opacity: 1;

                background: var(--highlight);

                color: #2B2A28;

                font-weight: 600;
            }

            .page {
                flex: 1;

                display: flex;
                justify-content: center;

                padding: 70px 20px 80px;
            }

            .board {
                position: relative;
                width: 100%;
                max-width: 620px;
            }

            .clip {
                position: absolute;
                top: -34px;
                left: 50%;

                transform: translateX(-50%);

                width: 140px;
                height: 46px;

                background:
                    linear-gradient(
                        180deg,
                        #C7CCD1,
                        var(--clip) 55%,
                        var(--clip-dark)
                    );

                border-radius: 8px;

                box-shadow:
                    0 8px 16px rgba(0, 0, 0, 0.35),
                    inset 0 1px 0 rgba(255, 255, 255, 0.4);

                z-index: 2;
            }

            .clip::after {
                content: "";

                position: absolute;

                left: 50%;
                top: 100%;

                transform: translateX(-50%);

                width: 60px;
                height: 14px;

                background: var(--clip-dark);

                border-radius: 0 0 6px 6px;
            }

            .paper {
                position: relative;

                background: var(--paper);

                border: 1px solid var(--paper-edge);
                border-radius: 6px;

                padding: 56px 40px 40px;

                box-shadow:
                    0 24px 60px rgba(0, 0, 0, 0.5),
                    0 2px 0 var(--paper-edge);
            }

            .banner {
                border-radius: 6px;

                padding: 12px 16px;

                font-size: 0.9rem;

                margin-bottom: 24px;
            }

            .banner.ok {
                background: var(--ok-bg);
                color: var(--ok);

                border: 1px solid var(--ok);
            }

            .banner.err {
                background: var(--err-bg);
                color: var(--danger);

                border: 1px solid var(--danger);
            }

            h1 {
                font-family: 'Permanent Marker', cursive;

                font-weight: 400;

                font-size: 1.8rem;

                margin: 0 0 8px;

                color: var(--text);
            }

            .lede {
                color: var(--muted);

                margin: 0 0 36px;

                line-height: 1.55;

                max-width: 55ch;
            }

            .field {
                margin-bottom: 30px;
            }

            .field label {
                display: block;

                font-size: 0.85rem;

                color: var(--muted);

                margin-bottom: 6px;
            }

            .field input[type="text"] {
                width: 100%;

                border: none;
                border-bottom: 1px solid #D8CFB9;

                background: transparent;

                font-family: 'IBM Plex Sans', sans-serif;

                font-size: 1.05rem;

                padding: 6px 2px;

                color: var(--text);

                outline: none;

                transition: border-color 0.15s ease;
            }

            .field input[type="text"]:focus {
                border-bottom: 2px solid var(--text);
            }

            .req-block-heading {
                display: flex;

                justify-content: space-between;
                align-items: baseline;

                border-bottom: 1px dashed var(--paper-edge);

                padding-bottom: 8px;

                margin-bottom: 14px;
            }

            .req-block-heading h2 {
                font-family: 'Permanent Marker', cursive;

                font-weight: 400;

                font-size: 1.1rem;

                margin: 0;

                color: var(--text);
            }

            #RequirementsText {
                width: 100%;

                min-height: 220px;

                resize: vertical;

                border: none;

                background:
                    repeating-linear-gradient(
                        to bottom,
                        transparent,
                        transparent 30px,
                        #EFE9D9 31px
                    );

                background-position: 0 6px;

                line-height: 31px;

                font-family: 'IBM Plex Sans', sans-serif;

                font-size: 1rem;

                color: var(--text);

                outline: none;

                padding: 0 2px;
            }

            #RequirementsText:focus {
                box-shadow: inset 0 -2px 0 var(--highlight);
            }

            #RequirementsText::placeholder {
                color: var(--muted);

                line-height: 1.9;
            }

            .submit-row {
                display: flex;

                align-items: center;

                gap: 18px;

                margin-top: 32px;
            }

            .submit-btn {
                font-family: 'IBM Plex Sans', sans-serif;

                font-weight: 600;

                font-size: 0.95rem;

                background: var(--text);

                color: var(--paper);

                border: none;

                padding: 14px 30px;

                border-radius: 6px;

                cursor: pointer;

                transition:
                    transform 0.15s ease,
                    background 0.15s ease;
            }

            .submit-btn:hover {
                background: var(--danger);

                transform: translateY(-1px);
            }

            .submit-btn:disabled {
                opacity: 0.6;

                cursor: wait;

                transform: none;
            }

            .submit-hint {
                color: var(--muted);

                font-size: 0.82rem;
            }

            @@media (max-width: 640px) {
                .site-nav {
                    flex-direction: column;
                    align-items: flex-start;

                    gap: 10px;

                    padding: 14px 16px;
                }

                .site-nav .links {
                    width: 100%;

                    justify-content: space-between;
                }

                .page {
                    padding: 30px 12px 40px;
                }

                .paper {
                    padding: 48px 22px 30px;
                }

                h1 {
                    font-size: 1.5rem;
                }

                .submit-row {
                    flex-direction: column;

                    align-items: stretch;
                }

                .submit-btn {
                    width: 100%;
                }

                .submit-hint {
                    text-align: center;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .submit-btn {
                    transition: none;
                }
            }
    </style>
</head>

<body>

    @{ ViewData["Active"] = "vacancy"; }
    @await Html.PartialAsync("_Nav")

    <div class="page">

    <div class="board">

        <div class="clip"></div>

        <div class="paper">

            @if (TempData["SavedMessage"] != null)
            {
                <div class="banner ok">
                    ✅ @TempData["SavedMessage"]
                </div>
            }

            @if (TempData["SaveError"] != null)
            {
                <div class="banner err">
                    ⚠️ @TempData["SaveError"]
                </div>
            }

            <h1>Вимоги до кандидата</h1>

            <p class="lede">
                Вкажіть назву вакансії та вставте текст вимог —
                можна просто скопіювати з готового опису.
            </p>

            <form asp-area="Hr"
                  asp-controller="Vacancies"
                  asp-action="Save"
                  method="post"
                  id="requirementsForm">

                <div class="field">

                    <label for="VacancyTitle">
                        Назва вакансії
                    </label>

                    <input type="text"
                           name="vacancyTitle"
                           id="VacancyTitle"
                           placeholder="Junior .NET Developer"
                           autocomplete="off"
                           required />

                </div>

                <div class="req-block-heading">

                    <h2>Вимоги</h2>

                </div>

                <textarea name="requirementsText"
                          id="RequirementsText"
                          placeholder="Наприклад:
                Досвід з ASP.NET Core від 1 року
                Знання C#
                Розуміння SQL
                Досвід роботи з Entity Framework Core
                Git"
                          required></textarea>

                <div class="submit-row">

                    <button type="submit"
                            class="submit-btn"
                            id="saveButton">
                        Зберегти вимоги
                    </button>

                    <span class="submit-hint">
                        Список можна відредагувати пізніше
                    </span>

                </div>

            </form>

        </div>

    </div>

    </div>

    <script>
            const form = document.getElementById("requirementsForm");
            const button = document.getElementById("saveButton");

            form.addEventListener("submit", function () {
                button.disabled = true;
                button.textContent = "Збереження...";
            });
    </script>

</body>
</html>